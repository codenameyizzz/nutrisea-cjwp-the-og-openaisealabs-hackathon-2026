# ==============================================================================
# NutriSea Backend Environment Configuration
# Copy this file to .env and fill in your secrets:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI Engine Configuration (Gemini via OpenAI-compatible endpoint OR OpenAI)
# ------------------------------------------------------------------------------
# Get your Google AI Studio API key at: https://aistudio.google.com/app/apikey
OPENAI_API_KEY=AIzaSy...your_google_ai_or_openai_api_key_here

# When using Google Gemini (default):
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_MODEL=gemini-2.0-flash
OPENAI_MINI_MODEL=gemini-2.0-flash-lite
EMBEDDING_MODEL=text-embedding-004

# When using OpenAI direct (optional):
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o
# OPENAI_MINI_MODEL=gpt-4o-mini
# EMBEDDING_MODEL=text-embedding-3-small


# ------------------------------------------------------------------------------
# 2. Database Configuration (Aiven Cloud PostgreSQL)
# ------------------------------------------------------------------------------
# Choose ONE of the following options:

# --- OPTION A: Full PostgreSQL URI (Recommended) ---
# Replace YOUR_AIVEN_PASSWORD with your avnadmin password from Aiven console:
DATABASE_URL=postgresql+psycopg2://avnadmin:YOUR_AIVEN_PASSWORD@pg-2072f052-cjwp.d.aivencloud.com:18968/defaultdb?sslmode=require
# AIVEN_PG_PASSWORD=your_aiven_password_here

# DATABASE_URL=sqlite:///./nutrisea.db

DB_SSL_REQUIRE=true
# Per worker. Keep small while multiple teammates share Aiven.
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=0
DB_POOL_TIMEOUT_SECONDS=10


# ------------------------------------------------------------------------------
# 3. Server & Security Settings
# ------------------------------------------------------------------------------
APP_ENV=development
# Comma-separated list or JSON array of allowed origins for Next.js frontend
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 4. FatSecret Platform API (OAuth 2.0 Food & Nutrition Database)
# ------------------------------------------------------------------------------
# Register for FatSecret Platform API credentials at:
# https://platform.fatsecret.com/
FATSECRET_CLIENT_ID=your_fatsecret_client_id_here
FATSECRET_CLIENT_SECRET=your_fatsecret_client_secret_here


# Ingredient administration: verified Clerk session tokens only.
# Replace the issuer with your exact Clerk instance URL (HTTPS, no trailing slash).
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
# Server-only key for operator/approval writes to public metadata. Request auth uses signed session claims.
CLERK_SECRET_KEY=sk_test_replace_with_your_clerk_secret_key
CLERK_AUDIENCE=
CLERK_AUTHORIZED_PARTIES=http://localhost:3000,http://127.0.0.1:3000
# Keep disabled for deployed/connected databases. Ingredient DDL is migration-only.
AUTO_CREATE_TABLES=false
